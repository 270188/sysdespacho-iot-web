        "fileName": "={{ $('Configuración').first().json.carpeta_salida.replace(/[\\/\\\\]+$/, '') + '/' + $binary.data.fileName }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "7a1aff2d-64e5-4a46-a760-07d833dcf7e2",
      "name": "Guardar Excel",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2260,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Resumen medido de la ejecución (no son estimaciones).\nconst cfg = $('Configuración').first().json;\nconst org = $('Organizar registros').first().json;\nconst filas = $('Columnas del Excel').all().map((i) => i.json);\nconst inicio = DateTime.fromISO(cfg.inicio);\nconst fin = $now;\nreturn [{ json: {\n  'Fechas con dato': filas.length,\n  'Rango consultado': `${cfg.fecha_inicio} a ${cfg.fecha_fin}`,\n  'Primera fecha': filas[0]['Fecha'],\n  'Última fecha': filas[filas.length - 1]['Fecha'],\n  'Fechas sin dato (n.d.)': org.fechas_sin_dato.length ? org.fechas_sin_dato.join(', ') : 'Ninguna',\n  'Archivo Excel': `${cfg.carpeta_salida.replace(/[\\/\\\\]+$/, '')}/${$('Generar Excel').first().binary.data.fileName}`,\n  'Duración (segundos)': Math.round(fin.diff(inicio, 'seconds').seconds * 10) / 10,\n} }];\n"
      },
      "id": "e9ffb812-ac3b-41db-8a67-e6de0cea344e",
      "name": "Resumen de la ejecución",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        260
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Organizar registros').first().json.url_api }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; SysDespacho-IA-BotRPA/1.0; uso academico)"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ea23ed20-eae2-4597-9201-338e43581bac",
      "name": "Consultar API del BCRP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        780
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Compara cada fecha del Excel con la respuesta de la API oficial del BCRP.\nconst MESES = { Ene: 1, Feb: 2, Mar: 3, Abr: 4, May: 5, Jun: 6, Jul: 7, Ago: 8, Set: 9, Sep: 9, Oct: 10, Nov: 11, Dic: 12 };\nconst api = $input.first().json;\nconst periodos = Array.isArray(api.periods) ? api.periods : [];\nconst porFecha = {};\nfor (const p of periodos) {\n  const m = String(p.name).match(/^(\\d{2})\\.?([A-Za-zé]{3})\\.?(\\d{2})$/);\n  if (!m || !MESES[m[2]]) continue;\n  porFecha[`20${m[3]}-${String(MESES[m[2]]).padStart(2, '0')}-${m[1]}`] = p.values || [];\n}\nconst ahora = $now.setZone('America/Lima').toFormat('yyyy-MM-dd HH:mm:ss');\nconst regs = $('Organizar registros').first().json.registros;\nreturn regs.map((r, i) => {\n  const v = porFecha[r.fecha];\n  // La API entrega más decimales; el BCRP publica 3 decimales, así que se redondea a 3 para comparar.\n  const r3 = (x) => Math.round(Number(x) * 1000) / 1000;\n  const cApi = v && v[0] !== 'n.d.' ? r3(v[0]) : null, vApi = v && v[1] !== 'n.d.' ? r3(v[1]) : null;\n  const ok = cApi !== null && vApi !== null && cApi === r3(r.compra) && vApi === r3(r.venta);\n  return { json: {\n    'N°': i + 1,\n    'Fecha': DateTime.fromISO(r.fecha).toFormat('dd/MM/yyyy'),\n    'Compra en Excel': r.compra,\n    'Compra en API BCRP (3 decimales)': cApi !== null ? cApi : '(sin dato en la API)',\n    'Venta en Excel': r.venta,\n    'Venta en API BCRP (3 decimales)': vApi !== null ? vApi : '(sin dato en la API)',\n    'Resultado': ok ? 'COINCIDE' : 'NO COINCIDE',\n    'Fuente de verificación (API)': $('Organizar registros').first().json.url_api,\n    'Fecha y hora de verificación': ahora,\n  } };\n});\n"
      },
      "id": "38fe6423-3e1c-4582-ac39-ce53475fff2d",
      "name": "Comparar con el Excel",
      "type": "n8n-nodes-base.code",
