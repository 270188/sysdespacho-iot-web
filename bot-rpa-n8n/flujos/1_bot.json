      "id": "f8c38aca-90dd-4e32-a17b-0acbf4db36ef",
      "name": "Leer filas de la tabla",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        940,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convierte cada fila de la tabla del BCRP en un registro: fecha, compra y venta.\nconst cfg = $('Armar URL de consulta').first().json;\nconst d = $input.first().json;\nconst MESES = { Ene: 1, Feb: 2, Mar: 3, Abr: 4, May: 5, Jun: 6, Jul: 7, Ago: 8, Set: 9, Sep: 9, Oct: 10, Nov: 11, Dic: 12 };\nconst texto = (h) => String(h || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nconst ahora = $now.setZone('America/Lima').toFormat('yyyy-MM-dd HH:mm:ss');\n\nconst registros = [];\nconst sinDato = [];\nfor (const fila of (Array.isArray(d.filas) ? d.filas : [])) {\n  const celdas = [...String(fila).matchAll(/<td[^>]*>([\\s\\S]*?)<\\/td>/gi)].map((m) => texto(m[1]));\n  if (celdas.length < 3) continue;                       // encabezados u otras filas\n  const m = celdas[0].match(/^(\\d{2})\\.?([A-Za-zé]{3})\\.?(\\d{2})$/);\n  if (!m || !MESES[m[2]]) continue;\n  const fecha = `20${m[3]}-${String(MESES[m[2]]).padStart(2, '0')}-${m[1]}`;\n  const num = (v) => (/^-?\\d+(\\.\\d+)?$/.test(v) ? Number(v) : null);\n  const compra = num(celdas[1]), venta = num(celdas[2]);\n  if (compra === null || venta === null) { sinDato.push(`${celdas[0]} (${celdas[1]} / ${celdas[2]})`); continue; }\n  registros.push({ fecha, fecha_bcrp: celdas[0], compra, venta });\n}\nregistros.sort((a, b) => a.fecha.localeCompare(b.fecha));\n\nreturn [{ json: {\n  titulo_pagina: d.titulo || '',\n  encabezados: d.encabezados || [],\n  url_consulta: cfg.url_consulta,\n  url_api: cfg.url_api,\n  fecha_consulta: ahora,\n  total_registros: registros.length,\n  fechas_sin_dato: sinDato,\n  registros,\n} }];\n"
      },
      "id": "c1d83c80-e9bd-42aa-b00f-f3c05bb4a298",
      "name": "Organizar registros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        280
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "963b19d1-8f80-477f-a91c-48d434cf2281",
              "name": "total_registros",
              "value": 0,
              "type": "number"
            },
            {
              "id": "7e61b37c-2caf-4eef-a20a-33f5ccbc77c2",
              "name": "incidencia",
              "value": "=No se pudo abrir {{ $('Armar URL de consulta').item.json.url_consulta }} — {{ (() => { const m = String($json.error?.message || $json.error || ''); if (/ECONNREFUSED|refused/i.test(m)) return 'el portal rechazó la conexión (no está disponible)'; if (/ENOTFOUND|getaddrinfo/i.test(m)) return 'no se encontró la dirección del portal'; if (/timeout|ETIMEDOUT/i.test(m)) return 'se agotó el tiempo de espera'; if (/403|forbidden/i.test(m)) return 'el portal denegó el acceso (error 403)'; if (/404/.test(m)) return 'la consulta no existe (error 404)'; return 'error de conexión'; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "80d5bdd6-37a5-4dd8-8553-ea863a44c1e8",
      "name": "Registrar incidencia",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8a333f6e-6bad-4cec-885d-8482a3ea3dd5",
              "leftValue": "={{ $json.total_registros }}",
              "rightValue": "={{ $('Configuración').first().json.minimo_fechas }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7ab9c2de-0704-45c0-8a27-90998c0175b9",
      "name": "¿Hay al menos 10 fechas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        340
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ $json.incidencia ? 'El bot no obtuvo datos. ' + $json.incidencia : 'El BCRP devolvió solo ' + $json.total_registros + ' fechas con datos entre ' + $('Configuración').first().json.fecha_inicio + ' y ' + $('Configuración').first().json.fecha_fin + '; se necesitan al menos ' + $('Configuración').first().json.minimo_fechas + '. Amplíe el rango de fechas.' }}"
      },
      "id": "c21e7252-1b58-4766-b413-5cb9ba8b6118",
      "name": "Detener y avisar",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1820,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Una fila por fecha con los encabezados del Excel y la fuente de consulta.\nconst d = $input.first().json;\nconst cfg = $('Configuración').first().json;\nreturn d.registros.map((r, i) => ({ json: {\n  'N°': i + 1,\n  'Fecha': DateTime.fromISO(r.fecha).toFormat('dd/MM/yyyy'),\n  'Fecha según BCRP': r.fecha_bcrp,\n  'Compra (S/ por US$)': r.compra,\n  'Venta (S/ por US$)': r.venta,\n  'Serie compra': cfg.serie_compra,\n  'Serie venta': cfg.serie_venta,\n  'Fuente de consulta (URL)': d.url_consulta,\n  'Fecha y hora de consulta': d.fecha_consulta,\n} }));\n"
      },
      "id": "0cf6ba73-5ef7-47b7-a4f5-4b5a3271062f",
      "name": "Columnas del Excel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        260
      ]
    },
