          "headerRow": true
        }
      },
      "id": "1e6abb8a-6e2b-4e45-8616-c9fc7f4fae8c",
      "name": "Generar Excel",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
