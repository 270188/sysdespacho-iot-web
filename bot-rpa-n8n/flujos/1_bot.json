      "typeVersion": 1,
      "position": [
        -80,
        100
      ]
    },
    {
      "parameters": {
        "content": "## 2. Consulta en el portal del BCRP\nAbre la tabla de resultados de las dos series para el rango de fechas y lee cada fila (fecha, compra y venta).",
        "height": 500,
        "width": 900,
        "color": 5
      },
      "id": "0e9d3da8-9271-4823-9bf6-8f6ce7672867",
      "name": "Nota 1",
